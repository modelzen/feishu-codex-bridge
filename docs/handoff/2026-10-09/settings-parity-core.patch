+} | {
+  kind: 'project';
+  botId: string;
+  projectName: string;
+} | {
+  kind: 'session';
+  botId: string;
+  threadId: string;
+};
+export type BotSettingsScope = Exclude<SettingsScope, {
+  kind: 'host';
