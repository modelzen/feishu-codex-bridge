{
  "name": "feishu-codex-bridge",
  "version": "0.0.1",
  "description": "Bridge Feishu/Lark messenger with local Codex via app-server (project=group, thread=session)",
  "type": "module",
  "bin": {
    "feishu-codex-bridge": "bin/feishu-codex-bridge.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node bin/feishu-codex-bridge.mjs start",
    "codex:protocol:update": "node tools/update-codex-protocol.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.65.0",
    "commander": "^12.1.0",
    "https-proxy-agent": "^9.0.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "feishu",
    "lark",
    "codex",
    "app-server",
    "cli",
    "bridge",
    "bot"
  ],
  "license": "MIT"
}
